---
import Page from '../layouts/Page.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Page title="Out of frame — Labcast" noindex>
  <Header slot="header" />
  <main id="main" class="container document">
    <p class="eyebrow">404 / OUT OF FRAME</p>
    <h1>
      This page missed
      <br />
      its cue.
    </h1>
    <p>Let’s get you back to the show.</p>
    <a class="button" href="/">
      Back to Labcast <span aria-hidden="true">↗</span>
    </a>
  </main>
  <Footer />
</Page>
