---
import '../styles/questions.css';
import { questions } from '../content';
---

<section
  class="questions-section container section-space"
  id="questions"
  aria-labelledby="questions-title"
>
  <div>
    <p class="section-number">02 / GOOD QUESTIONS</p>
    <h2 id="questions-title">
      Before
      <br />
      we roll.
    </h2>
    <p class="questions-note">
      A few things you might
      <br />
      be wondering.
    </p>
  </div>
  <div class="questions">
    {questions.map((item) => (
      <details>
        <summary>
          {item.question}
          <span aria-hidden="true">+</span>
        </summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</section>
