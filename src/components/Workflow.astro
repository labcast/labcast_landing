---
import '../styles/workflow.css';
import Mark from './Mark.astro';
import { workflow, steps } from '../content';
---

<section
  class="workflow-section"
  id="workflow"
  aria-labelledby="workflow-title"
>
  <div class="container section-space">
    <div class="section-label">
      <span class="section-number">02 / HOW IT WORKS</span>
      <span class="tiny-label">ONE EVENT. A SHARED POINT OF VIEW.</span>
    </div>
    <div class="section-heading">
      <h2 id="workflow-title">
        {workflow.headline[0]}
        <br />
        <span class="muted">{workflow.headline[1]}</span>
      </h2>
      <p>{workflow.description}</p>
    </div>
    <ol class="steps">
      {steps.map((step) => (
        <li>
          <div class="step-top">
            <span class="step-number">{step.number}</span>
            <span class="step-arrow" aria-hidden="true">
              ↗
            </span>
          </div>
          <span class="tiny-label">{step.tag}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
    <div class="workflow-note">
      <Mark />
      <p>
        Camera guidance stays with the crew.
        <br />
        <span>The audience gets the show.</span>
      </p>
      <span class="tiny-label">BEHIND THE SCENES → ON SCREEN</span>
    </div>
  </div>
</section>
