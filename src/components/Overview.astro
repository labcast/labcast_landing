---
import { idea } from '../content';
---

<section
  class="idea-section container section-space"
  id="idea"
  aria-labelledby="idea-title"
>
  <div class="section-label">
    <span class="section-number">01 / THE IDEA</span>
    <span class="small-cross" aria-hidden="true">
      +
    </span>
  </div>
  <div class="idea-grid">
    <h2 id="idea-title">
      {idea.headline[0]}
      <br />
      {idea.headline[1]}
      <br />
      <span class="muted">{idea.headline[2]}</span>
    </h2>
    <div class="idea-copy">
      <p class="large-copy">{idea.lead}</p>
      {idea.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <a class="text-link" href="#workflow">
        From the room to your audience <span aria-hidden="true">↘</span>
      </a>
    </div>
  </div>
</section>
