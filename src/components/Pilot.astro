---
import { pilot } from '../content';
---

<section
  class="pilot-section container section-space"
  id="pilot"
  aria-labelledby="pilot-title"
>
  <div class="section-label">
    <span class="section-number">03 / THE FIRST PILOT</span>
    <span class="small-cross" aria-hidden="true">
      +
    </span>
  </div>
  <div class="pilot-grid">
    <div>
      <span class="pilot-tag">SMALL START. REAL EVENT.</span>
      <h2 id="pilot-title">
        {pilot.headline[0]}
        <br />
        {pilot.headline[1]}
        <br />
        <span class="serif-word">{pilot.headline[2]}</span>
      </h2>
    </div>
    <div class="pilot-copy">
      <p class="large-copy">{pilot.lead}</p>
      <p>{pilot.description}</p>
      <ul class="pilot-list">
        {pilot.needs.map((need, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            {need}
          </li>
        ))}
      </ul>
      <a class="text-link" href="#contact">
        Have an event in mind? <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
