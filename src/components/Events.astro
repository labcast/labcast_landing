---
import { Image } from 'astro:assets';
import { audiences } from '../content';
import streamer from '../assets/streamer.jpg';
import audience from '../assets/audience.jpg';
import game from '../assets/game.jpg';
import '../styles/events.css';
const photos = { streamer, audience, game };
---

<section
  class="people container section-space"
  id="people"
  aria-labelledby="people-title"
>
  <div class="section-label">
    <span class="section-number">01 / MADE FOR YOU</span>
    <span class="tiny-label">GOOD THINGS DESERVE AN AUDIENCE.</span>
  </div>
  <div class="section-heading">
    <h2 id="people-title">
      Your moment.
      <br />
      <span class="outline-word">Your kind of show.</span>
    </h2>
    <p>
      For the people making something happen. And everyone who wants to be part
      of it.
    </p>
  </div>
  <div class="people-grid">
    {audiences.map((item, index) => (
      <article class={`person person-${item.id}`} id={item.id}>
        <div class="person-image">
          <Image
            src={photos[item.image as keyof typeof photos]}
            alt={item.alt}
            widths={[480, 800, 1200]}
            sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1100px) 45vw, 30vw"
            width={1200}
            height={800}
            fit="cover"
            loading="lazy"
            decoding="async"
            format="webp"
          />
          <span class="person-index">0{index + 1} ↗</span>
        </div>
        <div class="person-copy">
          <p class="tiny-label">{item.label}</p>
          <h3>
            {item.title.split('\n').map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))}
          </h3>
          <p class="person-description">{item.text}</p>
          <a class="text-link" href="#waitlist" data-audience={item.id}>
            {item.action}
            <span aria-hidden="true">↗</span>
          </a>
          <p class="person-note">{item.note}</p>
        </div>
      </article>
    ))}
  </div>
</section>
