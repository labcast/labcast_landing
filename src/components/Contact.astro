---
import '../styles/contact.css';
import Mark from './Mark.astro';
---

<section class="closing" aria-labelledby="closing-title">
  <div class="container closing-inner">
    <div class="closing-copy">
      <p class="eyebrow">
        <span class="status-dot" aria-hidden="true"></span> SMALL CREW. BIG
        POSSIBILITIES.
      </p>
      <h2 id="closing-title">
        Broadcast
        <br />
        like a pro<span>.</span>
      </h2>
      <p class="closing-description">
        Bring your cameras.
        <br />
        Labcast brings the show.
      </p>
      <a class="button" href="#waitlist">
        Join the waitlist <span aria-hidden="true">↗</span>
      </a>
      <span class="closing-note">FREE TO JOIN · EARLY-ACCESS UPDATES</span>
    </div>
    <div class="closing-art" aria-hidden="true">
      <div class="closing-orbit orbit-one"></div>
      <div class="closing-orbit orbit-two"></div>
      <div class="closing-seal">
        <Mark />
      </div>
      <span class="closing-sticker">
        GOOD THINGS
        <br />
        DESERVE A SHOW.
      </span>
      <svg class="closing-spark" viewBox="0 0 80 80" fill="none">
        <path
          d="M40 0v80M0 40h80M12 12l56 56M12 68l56-56"
          stroke="currentColor"
          stroke-width="6"
        />
      </svg>
    </div>
  </div>
</section>
