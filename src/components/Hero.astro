---
import '../styles/hero.css';
import { Image } from 'astro:assets';
import crew from '../assets/crew.png';
import WaitlistForm from './WaitlistForm.astro';
import Showcase from './Showcase.astro';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-art" aria-hidden="true">
    <Image
      src={crew}
      alt=""
      widths={[800, 1200, 1536]}
      sizes="100vw"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="hero-copy container">
    <p class="eyebrow">
      <span class="status-dot"></span> NO CREW TO HIRE. NO GEAR TO RENT.
    </p>
    <h1 id="hero-title">
      <span class="hero-line">Your phones.</span>
      <span class="hero-highlight">
        One big show<span class="hero-period">.</span>
      </span>
    </h1>
    <p class="hero-description">
      Labcast turns the phones you already have into one live broadcast. It
      switches angles and adds replays and graphics for you.
    </p>
    <p class="hero-welcome">
      For streamers, event organizers, sports clubs, creators and community
      events.
    </p>
    <div class="waitlist" id="waitlist">
      <WaitlistForm id="waitlist" source="website" />
    </div>
  </div>
</section>
<Showcase />
<script>
  import '../scripts/contact';
  import '../scripts/hero';
</script>
