---
import '../styles/hero.css';
import Studio from './Studio.astro';
import { hero } from '../content';
---

<section class="hero container" id="top" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">
      <span class="status-dot"></span> {hero.eyebrow}
    </p>
    <h1 id="hero-title">
      {hero.headline[0]}
      <br />
      <span>{hero.headline[1]}</span>
    </h1>
    <p class="hero-description">{hero.lead}</p>
    <p class="hero-detail">{hero.description}</p>
    <div class="hero-actions">
      <a class="button button-lime" href="#contact">
        {hero.action} <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="#workflow">
        See how it works <span aria-hidden="true">↓</span>
      </a>
    </div>
    <div class="development-note">
      <span class="small-cross" aria-hidden="true">
        +
      </span>
      <span>{hero.note}</span>
    </div>
  </div>
  <div class="hero-visual">
    <Studio />
    <div class="visual-note">
      <span class="note-line"></span>
      <span>
        THE PEOPLE ARE ALREADY THERE.
        <br />
        THE CAMERAS ARE, TOO.
      </span>
    </div>
  </div>
</section>
