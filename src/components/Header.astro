---
import Icon from './Icon.astro';
import '../styles/header.css';
import Mark from './Mark.astro';
import { navigation } from '../content';
---

<header class="header">
  <div class="container header-inner">
    <a class="wordmark" href="/" aria-label="Labcast home">
      <Mark />
      <span>labcast.</span>
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="navigation"
      aria-label="Open menu"
    >
      <Icon name="menu" />
    </button>
    <nav id="navigation" class="navigation" aria-label="Main navigation">
      {navigation.map((link, index) => (
        <a href={link.href} class="nav-link">
          <span class="nav-index" aria-hidden="true">
            0{index + 1}
          </span>
          <span>{link.label}</span>
          <Icon />
        </a>
      ))}
      <a href="/#waitlist" class="nav-cta">
        Join the waitlist <Icon />
      </a>
    </nav>
  </div>
</header>
<script>
  import '../scripts/navigation';
</script>
